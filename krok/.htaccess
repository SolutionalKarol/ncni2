# NCNI Krok: wejście tylko przez index.php (logowanie), dane serwera niedostępne z przeglądarki
Options -Indexes
DirectoryIndex index.php
<FilesMatch "^(app\.html|lib\.php)$|\.(sqlite|sqlite-wal|sqlite-shm|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
